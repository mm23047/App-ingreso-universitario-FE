{
  "name": "nuevo-ingreso-web-frontend",
  "version": "1.0.0",
  "description": "Frontend SPA (Web Components nativos + PWA) del Sistema de Ingreso Universitario",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "mocha",
    "test:junit": "mocha --reporter mocha-junit-reporter --reporter-options mochaFile=test-results/junit.xml",
    "test:integration:off": "mocha --no-config \"src/test/js/integration/server-off/**/*.test.js\" --require src/test/js/node-test-setup.cjs --timeout 5000",
    "coverage": "c8 mocha",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "c8": "^10.1.2",
    "mocha": "^10.7.3",
    "mocha-junit-reporter": "^2.2.1"
  },
  "c8": {
    "all": true,
    "include": [
      "src/js/control/**",
      "src/js/entity/**",
      "src/js/infra/app_state.js",
      "src/js/infra/notificaciones.js",
      "src/js/infra/router.js"
    ],
    "reporter": ["text-summary", "lcov"],
    "report-dir": "coverage"
  }
}
